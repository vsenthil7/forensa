{
    "compilerOptions":  {
                            "target":  "ES2022",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  false,
                            "skipLibCheck":  true,
                            "strict":  true,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "preserve",
                            "incremental":  true,
                            "types":  [
                                          "node",
                                          "vitest/globals",
                                          "@testing-library/jest-dom"
                                      ],
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "./src/*"
                                                  ]
                                      }
                        },
    "include":  [
                    "next-env.d.ts",
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    "vitest.config.ts",
                    "playwright.config.ts",
                    "vitest.setup.ts",
                    "eslint.config.mjs"
                ],
    "exclude":  [
                    "node_modules",
                    ".next",
                    "tests-e2e",
                    "coverage"
                ]
}
