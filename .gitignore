# Forensa .gitignore â€” pattern carried from Verixa with Forensa additions

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.Python

# Virtual environments
.venv/
venv/
env/

# Poetry
poetry.toml

# Testing / coverage
.coverage
.coverage.*
htmlcov/
.tox/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
coverage.xml
coverage/
apps/console/coverage/

# Node / pnpm
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*

# Next.js
.next/
out/
.vercel
.turbo

# Vitest
vitest.config.ts.timestamp-*

# Playwright
test-results/
playwright-report/
playwright/.cache/

# TypeScript
*.tsbuildinfo

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
logs/
*.log
src/logs/

# Secrets â€” NEVER commit
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Database
*.db
*.sqlite
*.sqlite3

# Build artefacts
*.tar.gz
*.zip
*.tgz

# Docker
.docker/
docker-compose.override.yml

# AWS
.aws/

# Scratch
.scratch/
tmp/
.tmp/

# Forensa: never commit raw evidence packs
dossiers/
test-dossiers/
sample-evidence/*.pdf
sample-evidence/*.json.signed

# Claude FILE BACKUP RULE artefacts (local-only, never committed)
_backup/

# Claude operating-rule artefacts (local-only, never committed):
# Rule 7 context log entries live here. Working notes, not deliverables.
.context_log/

# Forensa demo video recordings (large binaries; local-only)
# Only the TOP-LEVEL `demo/` folder is for recordings. The leading
# slash anchors the pattern so apps/console/tests-e2e/demo/ (which
# holds the captioned-demo SOURCE specs) is NOT ignored.
/demo/

# `demovideo/results/` is the run pointer dir. We don't want to
# track the actual `latest.txt` pointer that the recorder rewrites,
# but we DO want to track the .gitkeep so the folder structure ships.
# Standard gitignore gotcha: negating a path inside an ignored dir
# requires the parent dir to NOT be ignored. So we ignore the
# contents of demovideo/results/ instead of the dir itself.
demovideo/results/*
!demovideo/results/.gitkeep
!demovideo/results/creation/
demovideo/results/creation/*
!demovideo/results/creation/.gitkeep

