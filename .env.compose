# Forensa - docker-compose environment variables
#
# CP9.61 - this file is committed to git as the canonical compose env.
# It contains NO secrets (Gemini API key etc go in .env which is gitignored).
# To override any value, edit .env.compose.local (gitignored) and pass:
#   docker compose --env-file .env.compose --env-file .env.compose.local up -d
#
# Postgres
POSTGRES_DB=forensa
POSTGRES_USER=forensa
POSTGRES_PASSWORD=forensa_dev_pw
POSTGRES_HOST_PORT=5433

# API
API_HOST_PORT=8000

# Console
CONSOLE_HOST_PORT=3001

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Gemini (optional - falls back to MockNarrativeClient when unset)
# Real key lives in .env (gitignored). To wire it into compose, add to
# .env.compose.local: FORENSA_GEMINI_API_KEY=<your-key>
FORENSA_GEMINI_API_KEY=
FORENSA_GEMINI_MODEL_ID=gemini-2.5-pro
